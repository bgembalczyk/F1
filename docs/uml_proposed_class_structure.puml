@startuml Parser Hierarchy After Refactor
!theme plain
skinparam classAttributeIconSize 0

title Parser contracts and wiki families (actual state)

abstract class "ParserABC[In, Out]" as ParserABC

abstract class "HtmlTagParserABC[Out]" as HtmlTagParserABC
abstract class "HtmlSoupParserABC[Out]" as HtmlSoupParserABC

ParserABC <|-- HtmlTagParserABC
ParserABC <|-- HtmlSoupParserABC

abstract class "TableHtmlParserABC[Out]" as TableHtmlParserABC
abstract class "ListHtmlParserABC[Out]" as ListHtmlParserABC
abstract class "SectionHtmlParserABC[Out]" as SectionHtmlParserABC
abstract class "InfoboxHtmlParserABC[Out]" as InfoboxHtmlParserABC
abstract class "NavboxHtmlParserABC[Out]" as NavboxHtmlParserABC
abstract class "ParagraphHtmlParserABC[Out]" as ParagraphHtmlParserABC
abstract class "FigureHtmlParserABC[Out]" as FigureHtmlParserABC

HtmlTagParserABC <|-- TableHtmlParserABC
HtmlTagParserABC <|-- ListHtmlParserABC
HtmlSoupParserABC <|-- SectionHtmlParserABC
HtmlTagParserABC <|-- InfoboxHtmlParserABC
HtmlTagParserABC <|-- NavboxHtmlParserABC
HtmlTagParserABC <|-- ParagraphHtmlParserABC
HtmlTagParserABC <|-- FigureHtmlParserABC

abstract class WikiTableParserABC
abstract class WikiListParserABC
abstract class WikiSectionParserABC
abstract class WikiInfoboxParserABC
abstract class WikiNavboxParserABC
abstract class WikiFigureParserABC

ListHtmlParserABC <|-- WikiListParserABC
WikiListParserABC <|-- WikiTableParserABC
SectionHtmlParserABC <|-- WikiSectionParserABC
WikiListParserABC <|-- WikiInfoboxParserABC
NavboxHtmlParserABC <|-- WikiNavboxParserABC
FigureHtmlParserABC <|-- WikiFigureParserABC

note right of WikiTableParserABC
selector: table.wikitable
end note

note right of WikiListParserABC
selector: ul, ol
end note

note right of WikiSectionParserABC
selector: div.mw-heading2|3|4
end note

note right of WikiInfoboxParserABC
selector: table.infobox
end note

note right of WikiNavboxParserABC
selector: div.navbox
end note

note right of WikiFigureParserABC
selector: figure
end note

@enduml
